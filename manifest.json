{
  "manifest_version": 3,
  "name": "LeetCode → Notion",
  "version": "1.0.0",
  "description": "Log LeetCode problems to a Notion database and see what's due for review.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://api.notion.com/*", "https://leetcode.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LeetCode → Notion"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
